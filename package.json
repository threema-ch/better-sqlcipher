{
  "name": "better-sqlcipher",
  "version": "12.4.6-sqlcipher4.6.1-bearssl0.6",
  "description": "better-sqlite3 built with SQLCipher",
  "author": "Threema GmbH <opensource@threema.ch>",
  "main": "lib/index.js",
  "files": [
    "binding.gyp",
    "src/**/*.[ch]pp",
    "lib/**",
    "deps/**"
  ],
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x || 25.x"
  },
  "types": "lib/index.d.ts",
  "dependencies": {
    "bindings": "^1.5.0",
    "prebuild-install": "^7.1.1"
  },
  "overrides": {
    "prebuild": {
      "node-abi": "4.15.0"
    }
  },
  "devDependencies": {
    "chai": "^4.3.8",
    "cli-color": "^2.0.3",
    "fs-extra": "^11.1.1",
    "mocha": "^10.2.0",
    "tar": "^6.1.13"
  },
  "scripts": {
    "install": "node-gyp rebuild --release -j max",
