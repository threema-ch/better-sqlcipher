{
  "name": "better-sqlcipher",
  "version": "13.0.3-sqlcipher4.19.0-bearssl0.6",
  "description": "better-sqlite3 built with SQLCipher",
  "author": "Threema GmbH <opensource@threema.ch>",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./linux-x64": "./lib/linux-x64.js",
    "./linux-arm64": "./lib/linux-arm64.js",
    "./linuxmusl-x64": "./lib/linuxmusl-x64.js",
    "./linuxmusl-arm64": "./lib/linuxmusl-arm64.js",
    "./darwin-x64": "./lib/darwin-x64.js",
    "./darwin-arm64": "./lib/darwin-arm64.js",
    "./win32-x64": "./lib/win32-x64.js",
    "./win32-arm64": "./lib/win32-arm64.js",
    "./package.json": "./package.json"
  },
  "files": [
    "binding.gyp",
    "src/**/*.[ch]pp",
    "lib/**",
    "deps/**",
    "prebuilds/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "tar": "^7.5.21"
  },
  "devDependencies": {
    "chai": "^4.3.8",
    "cli-color": "^2.0.3",
    "fs-extra": "^11.1.1",
    "mocha": "^11.7.5"
  },
  "scripts": {
    "install": "node-gyp clean && node-gyp rebuild --release --force_build=1 -j max",
    "build-release": "node-gyp clean && node-gyp rebuild --release --force_build=1 -j max",
    "build-debug": "node-gyp clean && node-gyp rebuild --debug --force_build=1 -j max",
    "test": "mocha --exit --slow=75 --timeout=5000",
    "benchmark": "node benchmark",
    "download": "(cd deps && bash ./download.sh)",
    "clean": "rm -rf node_modules build prebuilds"
  },
  "license": "MIT",
  "keywords": [
    "sql",
    "sqlite",
    "sqlite3",
    "sqlcipher",
    "transactions",
    "user-defined functions",
    "aggregate functions",
    "window functions",
    "database"
  ]
}
